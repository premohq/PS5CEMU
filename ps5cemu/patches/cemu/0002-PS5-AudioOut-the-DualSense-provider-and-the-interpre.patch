 #include "input/api/SDL/SDLController.h"
 #endif
 
+#if defined(CEMU_PS5)
+#include "PS5PadController.h" // ps5cemu/port/cemu
+#endif
+
 ControllerPtr ControllerFactory::CreateController(InputAPI::Type api, std::string_view uuid,
                                                   std::string_view display_name)
 {
@@ -104,6 +108,10 @@ ControllerPtr ControllerFactory::CreateController(InputAPI::Type api, std::strin
 			const auto index = ConvertString<uint32>(uuid);
 			return std::make_shared<NativeWiimoteController>(index);
 		}
+#endif
+#if defined(CEMU_PS5)
+	case InputAPI::PS5Pad:
+		return std::make_shared<PS5PadController>(uuid, display_name);
 #endif
 	default:
 		throw std::invalid_argument(fmt::format("unhandled controller api: {}", api));
@@ -175,6 +183,10 @@ ControllerProviderPtr ControllerFactory::CreateControllerProvider(InputAPI::Type
 #if HAS_WIIMOTE
 	case InputAPI::Wiimote:
 		return std::make_shared<WiimoteControllerProvider>();
+#endif
+#if defined(CEMU_PS5)
+	case InputAPI::PS5Pad:
+		return std::make_shared<PS5PadControllerProvider>();
 #endif
 	default:
 		cemu_assert_debug(false);
diff --git a/src/input/InputManager.cpp b/src/input/InputManager.cpp
index 42b1db2..a492742 100644
--- a/src/input/InputManager.cpp
+++ b/src/input/InputManager.cpp
@@ -25,7 +25,10 @@ InputManager::InputManager()
 		}
 	}
 	*/
