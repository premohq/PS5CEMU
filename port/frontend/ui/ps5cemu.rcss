/* PS5Cemu additions to ProsperoEden's app.rcss: the elements its launcher does not have. */

/* Library: the graphic packs row where ProsperoEden has the console mode. */
#game-packs-setting { position: absolute; left: 42px; top: 550px; width: 736px; height: 94px; }
#game-packs-setting img { position: absolute; left: 0px; top: 0px; }
#game-packs-value { position: absolute; right: 26px; top: 0px; height: 94px; line-height: 94px; font-size: 24px; color: #dfe8a6; }
.library-row-meta { width: 110px; left: 620px; }

/* Graphic packs */
#packs-list-viewport { position: absolute; left: 30px; top: 62px; width: 760px; height: 606px; overflow: hidden; }
.pack-row-name { width: 560px; }
.pack-row-state { left: 590px; width: 140px; }
.pack-row-state.on { color: #dfe8a6; }
#packs-empty { display: none; position: absolute; left: 30px; top: 300px; width: 760px; height: 40px; color: #c5d0bd; font-size: 24px; line-height: 38px; text-align: center; }
#packs-empty.visible { display: block; }
#packs-position { position: absolute; left: 590px; top: 678px; width: 200px; height: 30px; color: #dfe8a6; font-size: 20px; line-height: 28px; text-align: right; }
#pack-detail-title { position: absolute; left: 36px; top: 62px; width: 748px; height: 96px; overflow: hidden; color: #fffcef; font-size: 32px; line-height: 42px; }
#pack-detail-description { position: absolute; left: 36px; top: 390px; width: 748px; height: 290px; overflow: hidden; color: #c5d0bd; font-size: 22px; line-height: 34px; }

/* Settings > Video has three rows. */
#video-dialog .dialog-row-0 { top: 170px; } #video-dialog .dialog-row-1 { top: 282px; } #video-dialog .dialog-row-2 { top: 394px; }

/* Starting a game */
#loading-cover { position: absolute; left: 816px; top: 300px; width: 288px; height: 288px; }
#loading-title { position: absolute; left: 160px; top: 620px; width: 1600px; height: 64px; color: #fffcef; font-size: 40px; line-height: 56px; text-align: center; }
#loading-caption { position: absolute; left: 160px; top: 696px; width: 1600px; height: 40px; color: #c5d0bd; font-size: 24px; line-height: 36px; text-align: center; }
