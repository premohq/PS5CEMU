<rml>
  <!-- PS5Cemu launcher. Layout, artwork, fonts and stylesheet are ProsperoEden's
       (headless/prosperoeden/ui, GPL-3.0-or-later, by BlackBearReloaded), adapted for Wii U games
       and recoloured dark blue (tools/recolour-ui.py); ps5cemu.rcss adds what is new. Element ids
       and classes follow ProsperoEden's so its styles apply. The background, the Wii U Homebrew
       Launcher's with its bubbles rising, is drawn under the page (frontend/bubbles.h). -->
  <head>
    <title>PS5Cemu</title>
    <link type="text/rcss" href="styles/app.rcss" />
    <link type="text/rcss" href="styles/ps5cemu.rcss" />
  </head>
  <body>
    <div id="app-shell">
      <header id="header">
        <img id="brand-icon" src="icons/ps5cemu-72.tga" width="72" height="72" alt=""/>
        <span id="brand-name">PS5CEMU</span>
        <span id="brand-version">WII U  /  PS5 EDITION</span>
        <span id="brand-version">WII U  /  PS5 EDITION  /  v0.2.0</span>
        <span id="menu-clock">--:--</span>
      </header>
      <nav id="menu">
        <button id="load-rom" class="nav-item"><img class="nav-focus" src="chrome/nav-focused.tga" width="136" height="64" alt=""/><span>Library</span></button>
        <button id="settings" class="nav-item"><img class="nav-focus" src="chrome/nav-focused.tga" width="136" height="64" alt=""/><span>Settings</span></button>
        <button id="help-about" class="nav-item"><img class="nav-focus" src="chrome/nav-focused.tga" width="136" height="64" alt=""/><span>About</span></button>
      </nav>

      <main id="last-played-card">
        <img class="hero-chrome" src="chrome/hero-panel.tga" width="1680" height="480" alt=""/>
        <img id="last-played-cover" src="icons/ps5cemu.tga" width="336" height="336" alt=""/>
        <span class="hero-kicker">CONTINUE PLAYING</span>
        <span id="last-played-title">Your next adventure</span>
        <span id="last-played-caption">Choose a game from your library.</span>
        <button id="continue-game" class="hero-button"><img class="hero-button-chrome base-chrome" src="chrome/hero-button.tga" width="272" height="72" alt=""/><img class="hero-button-chrome focused-chrome" src="chrome/hero-button-focused.tga" width="272" height="72" alt=""/><span id="continue-copy">Launch game</span></button>
        <button id="hero-options" class="hero-button"><img class="hero-button-chrome base-chrome" src="chrome/hero-button.tga" width="272" height="72" alt=""/><img class="hero-button-chrome focused-chrome" src="chrome/hero-button-focused.tga" width="272" height="72" alt=""/><span>Graphic packs</span></button>
        <span class="hero-footnote">Cemu, the Wii U emulator, on PlayStation 5</span>
      </main>

      <section id="recent-section">
        <span class="section-label">RECENTLY PLAYED</span>
        <button id="view-all"><img class="view-all-focus" src="chrome/view-all-focused.tga" width="304" height="40" alt=""/><span>VIEW ALL GAMES</span></button>
        <span id="recent-empty">Games you launch will appear here.</span>
        <button id="recent-0" class="recent-tile"><img class="recent-chrome base-chrome" src="chrome/recent-tile.tga" width="400" height="144" alt=""/><img class="recent-chrome focused-chrome" src="chrome/recent-tile-focused.tga" width="400" height="144" alt=""/><img id="recent-cover-0" class="recent-cover" src="icons/ps5cemu.tga" width="96" height="96" alt=""/><span id="recent-title-0" class="recent-title"></span></button>
        <button id="recent-1" class="recent-tile"><img class="recent-chrome base-chrome" src="chrome/recent-tile.tga" width="400" height="144" alt=""/><img class="recent-chrome focused-chrome" src="chrome/recent-tile-focused.tga" width="400" height="144" alt=""/><img id="recent-cover-1" class="recent-cover" src="icons/ps5cemu.tga" width="96" height="96" alt=""/><span id="recent-title-1" class="recent-title"></span></button>
        <button id="recent-2" class="recent-tile"><img class="recent-chrome base-chrome" src="chrome/recent-tile.tga" width="400" height="144" alt=""/><img class="recent-chrome focused-chrome" src="chrome/recent-tile-focused.tga" width="400" height="144" alt=""/><img id="recent-cover-2" class="recent-cover" src="icons/ps5cemu.tga" width="96" height="96" alt=""/><span id="recent-title-2" class="recent-title"></span></button>
        <button id="recent-3" class="recent-tile"><img class="recent-chrome base-chrome" src="chrome/recent-tile.tga" width="400" height="144" alt=""/><img class="recent-chrome focused-chrome" src="chrome/recent-tile-focused.tga" width="400" height="144" alt=""/><img id="recent-cover-3" class="recent-cover" src="icons/ps5cemu.tga" width="96" height="96" alt=""/><span id="recent-title-3" class="recent-title"></span></button>
      </section>

      <div id="startup-status" class="quiet"></div>
      <footer id="footer" class="hints"><span class="hint"><img src="icons/cross-mono.tga" width="26" height="26" alt=""/><span class="hint-text">Select</span></span><span class="hint"><img src="icons/triangle-mono.tga" width="26" height="26" alt=""/><span class="hint-text">Graphic packs</span></span><span class="hint"><img src="icons/dpad-mono.tga" width="26" height="26" alt=""/><span class="hint-text">Navigate</span></span><span id="system-status">Looking for games</span></footer>

      <!-- Library -->
      <div id="rom-dialog" class="library-screen">
        <span class="library-shade"></span>
        <span class="library-title">Your games</span>
        <span class="library-copy">Select a game to begin</span>
        <section class="library-list-panel">
          <img class="library-panel-chrome" src="chrome/dialog-panel.tga" width="820" height="720" alt=""/>
          <span class="library-panel-kicker">LIBRARY</span>
          <div id="rom-list-viewport"><div id="rom-list-track">
            <span id="rom-row-0" class="library-row library-row-0"><img class="library-row-chrome base-chrome" src="chrome/library-row-normal.tga" width="760" height="78" alt=""/><img class="library-row-chrome focused-chrome" src="chrome/library-row-focused.tga" width="760" height="78" alt=""/><span id="rom-name-0" class="library-row-name rom-row-name"></span><span id="rom-format-0" class="library-row-meta"></span></span>
            <span id="rom-row-1" class="library-row library-row-1"><img class="library-row-chrome base-chrome" src="chrome/library-row-normal.tga" width="760" height="78" alt=""/><img class="library-row-chrome focused-chrome" src="chrome/library-row-focused.tga" width="760" height="78" alt=""/><span id="rom-name-1" class="library-row-name rom-row-name"></span><span id="rom-format-1" class="library-row-meta"></span></span>
            <span id="rom-row-2" class="library-row library-row-2"><img class="library-row-chrome base-chrome" src="chrome/library-row-normal.tga" width="760" height="78" alt=""/><img class="library-row-chrome focused-chrome" src="chrome/library-row-focused.tga" width="760" height="78" alt=""/><span id="rom-name-2" class="library-row-name rom-row-name"></span><span id="rom-format-2" class="library-row-meta"></span></span>
            <span id="rom-row-3" class="library-row library-row-3"><img class="library-row-chrome base-chrome" src="chrome/library-row-normal.tga" width="760" height="78" alt=""/><img class="library-row-chrome focused-chrome" src="chrome/library-row-focused.tga" width="760" height="78" alt=""/><span id="rom-name-3" class="library-row-name rom-row-name"></span><span id="rom-format-3" class="library-row-meta"></span></span>
            <span id="rom-row-4" class="library-row library-row-4"><img class="library-row-chrome base-chrome" src="chrome/library-row-normal.tga" width="760" height="78" alt=""/><img class="library-row-chrome focused-chrome" src="chrome/library-row-focused.tga" width="760" height="78" alt=""/><span id="rom-name-4" class="library-row-name rom-row-name"></span><span id="rom-format-4" class="library-row-meta"></span></span>
            <span id="rom-row-5" class="library-row library-row-5"><img class="library-row-chrome base-chrome" src="chrome/library-row-normal.tga" width="760" height="78" alt=""/><img class="library-row-chrome focused-chrome" src="chrome/library-row-focused.tga" width="760" height="78" alt=""/><span id="rom-name-5" class="library-row-name rom-row-name"></span><span id="rom-format-5" class="library-row-meta"></span></span>
            <span id="rom-row-6" class="library-row library-row-6"><img class="library-row-chrome base-chrome" src="chrome/library-row-normal.tga" width="760" height="78" alt=""/><img class="library-row-chrome focused-chrome" src="chrome/library-row-focused.tga" width="760" height="78" alt=""/><span id="rom-name-6" class="library-row-name rom-row-name"></span><span id="rom-format-6" class="library-row-meta"></span></span>
          </div></div>
          <span id="library-empty">No games found. Put them in the game files folder.</span>
          <span id="rom-scrollbar"><img class="scrollbar-track" src="chrome/scrollbar-track.tga" width="10" height="606" alt=""/><img id="rom-scrollbar-thumb" src="chrome/scrollbar-thumb.tga" width="10" height="110" alt=""/></span>
          <span id="library-position">0 OF 0</span>
        </section>
        <aside class="game-detail-panel">
          <img class="library-panel-chrome" src="chrome/dialog-panel.tga" width="820" height="720" alt=""/>
          <span class="detail-kicker">GAME DETAILS</span>
          <span id="game-detail-title">No game selected</span>
          <img id="game-cover" src="icons/ps5cemu.tga" width="288" height="288" alt=""/><span id="cover-caption"></span>
          <span class="game-detail-label game-detail-line-0">TITLE ID</span><span id="game-detail-format" class="game-detail-value game-detail-line-0">-</span>
          <span class="game-detail-label game-detail-line-1">VERSION</span><span id="game-detail-size" class="game-detail-value game-detail-line-1">-</span>
          <span class="game-detail-label game-detail-line-2">DLC</span><span id="game-detail-dlc" class="game-detail-value game-detail-line-2">-</span>
          <span class="game-path-label">FILES</span><span id="game-detail-path" class="game-path">-</span>
          <span id="game-packs-setting"><img src="chrome/dialog-row-normal.tga" width="736" height="94" alt=""/><span class="game-mode-label">Graphic packs</span><span id="game-packs-value">-</span></span>
          <span id="game-mode-hint"><img src="icons/triangle-mono.tga" width="26" height="26" alt=""/><span id="game-mode-hint-text">Choose this game's graphic packs.</span></span>
        </aside>
        <footer class="hints"><span class="hint"><img src="icons/cross-mono.tga" width="26" height="26" alt=""/><span class="hint-text">Play</span></span><span class="hint"><img src="icons/circle-mono.tga" width="26" height="26" alt=""/><span class="hint-text">Back</span></span><span class="hint"><img src="icons/updown-mono.tga" width="26" height="26" alt=""/><span class="hint-text">Browse games</span></span><span class="hint"><img src="icons/triangle-mono.tga" width="26" height="26" alt=""/><span class="hint-text">Graphic packs</span></span><span class="hint hint-pair"><img src="icons/l1-mono.tga" width="26" height="26" alt=""/><img class="hint-second" src="icons/r1-mono.tga" width="26" height="26" alt=""/><span class="hint-text">Page</span></span></footer>
      </div>

      <!-- Graphic packs of one game, laid out as Cemu's Graphic Packs window: the packs, and each
           one's presets, a dropdown for each of its categories -->
      <div id="packs-dialog" class="library-screen">
        <span class="library-shade"></span>
        <span class="library-title">Graphic packs</span>
        <span id="packs-game" class="library-copy"></span>
        <section class="library-list-panel">
          <img class="library-panel-chrome" src="chrome/dialog-panel.tga" width="820" height="720" alt=""/>
          <span class="library-panel-kicker">COMMUNITY PACKS</span>
          <div id="packs-list-viewport">
            <span id="pack-row-0" class="library-row library-row-0"><img class="library-row-chrome base-chrome" src="chrome/library-row-normal.tga" width="760" height="78" alt=""/><img class="library-row-chrome focused-chrome" src="chrome/library-row-focused.tga" width="760" height="78" alt=""/><span id="pack-name-0" class="library-row-name pack-row-name"></span><span id="pack-state-0" class="library-row-meta pack-row-state"></span></span>
            <span id="pack-row-1" class="library-row library-row-1"><img class="library-row-chrome base-chrome" src="chrome/library-row-normal.tga" width="760" height="78" alt=""/><img class="library-row-chrome focused-chrome" src="chrome/library-row-focused.tga" width="760" height="78" alt=""/><span id="pack-name-1" class="library-row-name pack-row-name"></span><span id="pack-state-1" class="library-row-meta pack-row-state"></span></span>
            <span id="pack-row-2" class="library-row library-row-2"><img class="library-row-chrome base-chrome" src="chrome/library-row-normal.tga" width="760" height="78" alt=""/><img class="library-row-chrome focused-chrome" src="chrome/library-row-focused.tga" width="760" height="78" alt=""/><span id="pack-name-2" class="library-row-name pack-row-name"></span><span id="pack-state-2" class="library-row-meta pack-row-state"></span></span>
            <span id="pack-row-3" class="library-row library-row-3"><img class="library-row-chrome base-chrome" src="chrome/library-row-normal.tga" width="760" height="78" alt=""/><img class="library-row-chrome focused-chrome" src="chrome/library-row-focused.tga" width="760" height="78" alt=""/><span id="pack-name-3" class="library-row-name pack-row-name"></span><span id="pack-state-3" class="library-row-meta pack-row-state"></span></span>
            <span id="pack-row-4" class="library-row library-row-4"><img class="library-row-chrome base-chrome" src="chrome/library-row-normal.tga" width="760" height="78" alt=""/><img class="library-row-chrome focused-chrome" src="chrome/library-row-focused.tga" width="760" height="78" alt=""/><span id="pack-name-4" class="library-row-name pack-row-name"></span><span id="pack-state-4" class="library-row-meta pack-row-state"></span></span>
            <span id="pack-row-5" class="library-row library-row-5"><img class="library-row-chrome base-chrome" src="chrome/library-row-normal.tga" width="760" height="78" alt=""/><img class="library-row-chrome focused-chrome" src="chrome/library-row-focused.tga" width="760" height="78" alt=""/><span id="pack-name-5" class="library-row-name pack-row-name"></span><span id="pack-state-5" class="library-row-meta pack-row-state"></span></span>
            <span id="pack-row-6" class="library-row library-row-6"><img class="library-row-chrome base-chrome" src="chrome/library-row-normal.tga" width="760" height="78" alt=""/><img class="library-row-chrome focused-chrome" src="chrome/library-row-focused.tga" width="760" height="78" alt=""/><span id="pack-name-6" class="library-row-name pack-row-name"></span><span id="pack-state-6" class="library-row-meta pack-row-state"></span></span>
          </div>
          <span id="packs-empty">No graphic packs for this game.</span>
          <span id="packs-position">0 OF 0</span>
        </section>
        <aside class="game-detail-panel">
          <img class="library-panel-chrome" src="chrome/dialog-panel.tga" width="820" height="720" alt=""/>
          <span id="pack-detail-kicker" class="detail-kicker">GRAPHIC PACK</span>
          <span id="pack-detail-title"></span>
          <span id="pack-detail-description"></span>
          <span class="about-divider pack-divider"></span>
          <span id="presets-kicker" class="detail-kicker presets-kicker">PRESETS</span>
          <span id="presets-empty">This pack has no presets: it is only on or off.</span>
          <div id="presets-viewport">
            <span id="preset-row-0" class="library-row library-row-0 preset-row"><img class="library-row-chrome base-chrome" src="chrome/library-row-normal.tga" width="760" height="78" alt=""/><img class="library-row-chrome focused-chrome" src="chrome/library-row-focused.tga" width="760" height="78" alt=""/><span id="preset-label-0" class="preset-label"></span><span id="preset-value-0" class="preset-value"></span><span class="preset-arrow"></span></span>
            <span id="preset-row-1" class="library-row library-row-1 preset-row"><img class="library-row-chrome base-chrome" src="chrome/library-row-normal.tga" width="760" height="78" alt=""/><img class="library-row-chrome focused-chrome" src="chrome/library-row-focused.tga" width="760" height="78" alt=""/><span id="preset-label-1" class="preset-label"></span><span id="preset-value-1" class="preset-value"></span><span class="preset-arrow"></span></span>
            <span id="preset-row-2" class="library-row library-row-2 preset-row"><img class="library-row-chrome base-chrome" src="chrome/library-row-normal.tga" width="760" height="78" alt=""/><img class="library-row-chrome focused-chrome" src="chrome/library-row-focused.tga" width="760" height="78" alt=""/><span id="preset-label-2" class="preset-label"></span><span id="preset-value-2" class="preset-value"></span><span class="preset-arrow"></span></span>
            <span id="preset-row-3" class="library-row library-row-3 preset-row"><img class="library-row-chrome base-chrome" src="chrome/library-row-normal.tga" width="760" height="78" alt=""/><img class="library-row-chrome focused-chrome" src="chrome/library-row-focused.tga" width="760" height="78" alt=""/><span id="preset-label-3" class="preset-label"></span><span id="preset-value-3" class="preset-value"></span><span class="preset-arrow"></span></span>
          </div>
          <span id="presets-position"></span>
        </aside>
        <footer class="hints"><span class="hint"><img src="icons/cross-mono.tga" width="26" height="26" alt=""/><span id="packs-hint-0" class="hint-text">On / off</span></span><span class="hint"><img src="icons/circle-mono.tga" width="26" height="26" alt=""/><span id="packs-hint-1" class="hint-text">Back</span></span><span class="hint"><img src="icons/updown-mono.tga" width="26" height="26" alt=""/><span id="packs-hint-2" class="hint-text">Browse packs</span></span><span class="hint"><img src="icons/leftright-mono.tga" width="26" height="26" alt=""/><span id="packs-hint-3" class="hint-text">Presets</span></span></footer>
      </div>

      <!-- Settings -->
      <div id="settings-dialog" class="settings-screen">
        <span class="library-shade"></span>
        <span class="library-title">Settings</span><span class="library-copy">Fine-tune your experience</span>
        <section class="settings-list-panel">
        <img class="library-panel-chrome" src="chrome/dialog-panel.tga" width="820" height="720" alt=""/>
        <span class="library-panel-kicker">PREFERENCES</span>
        <span id="settings-row-0" class="dialog-row settings-row-0"><img class="dialog-row-chrome base-chrome" src="chrome/dialog-row-normal.tga" width="736" height="94" alt=""/><img class="dialog-row-chrome focused-chrome" src="chrome/dialog-row-focused.tga" width="736" height="94" alt=""/><span>Video</span></span>
        <span id="settings-row-1" class="dialog-row settings-row-1"><img class="dialog-row-chrome base-chrome" src="chrome/dialog-row-normal.tga" width="736" height="94" alt=""/><img class="dialog-row-chrome focused-chrome" src="chrome/dialog-row-focused.tga" width="736" height="94" alt=""/><span>Audio</span></span>
        <span id="settings-row-2" class="dialog-row settings-row-2"><img class="dialog-row-chrome base-chrome" src="chrome/dialog-row-normal.tga" width="736" height="94" alt=""/><img class="dialog-row-chrome focused-chrome" src="chrome/dialog-row-focused.tga" width="736" height="94" alt=""/><span>Controls</span></span>
        <span id="settings-row-3" class="dialog-row settings-row-3"><img class="dialog-row-chrome base-chrome" src="chrome/dialog-row-normal.tga" width="736" height="94" alt=""/><img class="dialog-row-chrome focused-chrome" src="chrome/dialog-row-focused.tga" width="736" height="94" alt=""/><span>Game files</span></span>
        <span id="settings-row-4" class="dialog-row settings-row-4"><img class="dialog-row-chrome base-chrome" src="chrome/dialog-row-normal.tga" width="736" height="94" alt=""/><img class="dialog-row-chrome focused-chrome" src="chrome/dialog-row-focused.tga" width="736" height="94" alt=""/><span>Install updates and DLC</span></span>
        <span id="settings-row-5" class="dialog-row settings-row-5"><img class="dialog-row-chrome base-chrome" src="chrome/dialog-row-normal.tga" width="736" height="94" alt=""/><img class="dialog-row-chrome focused-chrome" src="chrome/dialog-row-focused.tga" width="736" height="94" alt=""/><span>Diagnostics</span></span>
        </section>
        <aside class="settings-detail-panel"><img class="library-panel-chrome" src="chrome/dialog-panel.tga" width="820" height="720" alt=""/>
          <span class="detail-kicker">ON THIS CONSOLE</span>
          <span class="settings-detail-title">Make it yours.</span>
          <span class="settings-detail-copy">Adjust the essentials without leaving your library behind.</span>
          <span class="settings-detail-label settings-detail-0">VIDEO</span><span class="settings-detail-value settings-detail-0">Upscaling filter, 120 Hz, overlay</span>
          <span class="settings-detail-label settings-detail-1">AUDIO</span><span class="settings-detail-value settings-detail-1">Game volume</span>
          <span class="settings-detail-label settings-detail-2">CONTROLS</span><span class="settings-detail-value settings-detail-2">Controllers, buttons, motion, vibration</span>
          <span class="settings-detail-label settings-detail-3">GAME FILES</span><span class="settings-detail-value settings-detail-3">The folder for your Wii U games</span>
          <span class="settings-detail-label settings-detail-4">INSTALL</span><span class="settings-detail-value settings-detail-4">Updates and DLC into the Wii U storage</span>
          <span class="settings-detail-label settings-detail-5">DIAGNOSTICS</span><span class="settings-detail-value settings-detail-5">Jailbreak, JIT and log files</span>
        </aside>
        <footer class="hints"><span class="hint"><img src="icons/cross-mono.tga" width="26" height="26" alt=""/><span class="hint-text">Select</span></span><span class="hint"><img src="icons/circle-mono.tga" width="26" height="26" alt=""/><span class="hint-text">Back</span></span><span class="hint"><img src="icons/updown-mono.tga" width="26" height="26" alt=""/><span class="hint-text">Browse settings</span></span></footer>
      </div>

      <!-- Settings > Controls: the players -->
      <div id="controls-dialog" class="library-screen">
        <span class="library-shade"></span>
        <span class="library-title">Controls</span>
        <span class="library-copy">Cemu's controller settings, for each player's DualSense</span>
        <section class="library-list-panel">
          <img class="library-panel-chrome" src="chrome/dialog-panel.tga" width="820" height="720" alt=""/>
          <span class="library-panel-kicker">PLAYERS</span>
          <div class="list-viewport">
            <span id="control-row-0" class="library-row library-row-0"><img class="library-row-chrome base-chrome" src="chrome/library-row-normal.tga" width="760" height="78" alt=""/><img class="library-row-chrome focused-chrome" src="chrome/library-row-focused.tga" width="760" height="78" alt=""/><span id="control-name-0" class="library-row-name setting-name">Player 1</span><span id="control-value-0" class="setting-value"></span></span>
            <span id="control-row-1" class="library-row library-row-1"><img class="library-row-chrome base-chrome" src="chrome/library-row-normal.tga" width="760" height="78" alt=""/><img class="library-row-chrome focused-chrome" src="chrome/library-row-focused.tga" width="760" height="78" alt=""/><span id="control-name-1" class="library-row-name setting-name">Player 2</span><span id="control-value-1" class="setting-value"></span></span>
            <span id="control-row-2" class="library-row library-row-2"><img class="library-row-chrome base-chrome" src="chrome/library-row-normal.tga" width="760" height="78" alt=""/><img class="library-row-chrome focused-chrome" src="chrome/library-row-focused.tga" width="760" height="78" alt=""/><span id="control-name-2" class="library-row-name setting-name">Player 3</span><span id="control-value-2" class="setting-value"></span></span>
