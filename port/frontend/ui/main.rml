<rml>
  <!-- PS5Cemu launcher. Layout, artwork, fonts and stylesheet are ProsperoEden's
       (headless/prosperoeden/ui, GPL-3.0-or-later, by BlackBearReloaded), adapted for Wii U games;
       ps5cemu.rcss adds what is new. Element ids and classes follow ProsperoEden's so its styles apply. -->
  <head>
    <title>PS5Cemu</title>
    <link type="text/rcss" href="styles/app.rcss" />
    <link type="text/rcss" href="styles/ps5cemu.rcss" />
  </head>
  <body>
    <div id="app-shell">
      <img id="background" src="background-menu.tga" width="2048" height="1152" alt=""/>
      <div id="shade"></div>

      <header id="header">
        <img id="brand-icon" src="icons/ps5cemu-72.tga" width="72" height="72" alt=""/>
        <span id="brand-name">PS5CEMU</span>
        <span id="brand-version">WII U  /  PS5 EDITION  /  v0.2.0</span>
        <span id="menu-clock">--:--</span>
      </header>
      <nav id="menu">
        <button id="load-rom" class="nav-item"><img class="nav-focus" src="chrome/nav-focused.tga" width="136" height="64" alt=""/><span>Library</span></button>
        <button id="settings" class="nav-item"><img class="nav-focus" src="chrome/nav-focused.tga" width="136" height="64" alt=""/><span>Settings</span></button>
        <button id="help-about" class="nav-item"><img class="nav-focus" src="chrome/nav-focused.tga" width="136" height="64" alt=""/><span>About</span></button>
      </nav>

      <main id="last-played-card">
        <img class="hero-chrome" src="chrome/hero-panel.tga" width="1680" height="480" alt=""/>
        <img id="last-played-cover" src="icons/ps5cemu.tga" width="336" height="336" alt=""/>
        <span class="hero-kicker">CONTINUE PLAYING</span>
        <span id="last-played-title">Your next adventure</span>
        <span id="last-played-caption">Choose a game from your library.</span>
        <button id="continue-game" class="hero-button"><img class="hero-button-chrome base-chrome" src="chrome/hero-button.tga" width="272" height="72" alt=""/><img class="hero-button-chrome focused-chrome" src="chrome/hero-button-focused.tga" width="272" height="72" alt=""/><span id="continue-copy">Launch game</span></button>
        <button id="hero-options" class="hero-button"><img class="hero-button-chrome base-chrome" src="chrome/hero-button.tga" width="272" height="72" alt=""/><img class="hero-button-chrome focused-chrome" src="chrome/hero-button-focused.tga" width="272" height="72" alt=""/><span>Graphic packs</span></button>
        <span class="hero-footnote">Cemu, the Wii U emulator, on PlayStation 5</span>
      </main>

      <section id="recent-section">
        <span class="section-label">RECENTLY PLAYED</span>
        <button id="view-all"><img class="view-all-focus" src="chrome/view-all-focused.tga" width="304" height="40" alt=""/><span>VIEW ALL GAMES</span></button>
        <span id="recent-empty">Games you launch will appear here.</span>
        <button id="recent-0" class="recent-tile"><img class="recent-chrome base-chrome" src="chrome/recent-tile.tga" width="400" height="144" alt=""/><img class="recent-chrome focused-chrome" src="chrome/recent-tile-focused.tga" width="400" height="144" alt=""/><img id="recent-cover-0" class="recent-cover" src="icons/ps5cemu.tga" width="96" height="96" alt=""/><span id="recent-title-0" class="recent-title"></span></button>
        <button id="recent-1" class="recent-tile"><img class="recent-chrome base-chrome" src="chrome/recent-tile.tga" width="400" height="144" alt=""/><img class="recent-chrome focused-chrome" src="chrome/recent-tile-focused.tga" width="400" height="144" alt=""/><img id="recent-cover-1" class="recent-cover" src="icons/ps5cemu.tga" width="96" height="96" alt=""/><span id="recent-title-1" class="recent-title"></span></button>
        <button id="recent-2" class="recent-tile"><img class="recent-chrome base-chrome" src="chrome/recent-tile.tga" width="400" height="144" alt=""/><img class="recent-chrome focused-chrome" src="chrome/recent-tile-focused.tga" width="400" height="144" alt=""/><img id="recent-cover-2" class="recent-cover" src="icons/ps5cemu.tga" width="96" height="96" alt=""/><span id="recent-title-2" class="recent-title"></span></button>
        <button id="recent-3" class="recent-tile"><img class="recent-chrome base-chrome" src="chrome/recent-tile.tga" width="400" height="144" alt=""/><img class="recent-chrome focused-chrome" src="chrome/recent-tile-focused.tga" width="400" height="144" alt=""/><img id="recent-cover-3" class="recent-cover" src="icons/ps5cemu.tga" width="96" height="96" alt=""/><span id="recent-title-3" class="recent-title"></span></button>
      </section>

      <div id="startup-status" class="quiet"></div>
      <footer id="footer">
        <span class="controller-hint hint-select"><img src="icons/cross-mono.tga" width="26" height="26" alt=""/><span>Select</span></span>
        <span class="controller-hint hint-options"><img src="icons/triangle-mono.tga" width="26" height="26" alt=""/><span>Graphic packs</span></span>
        <span class="controller-hint hint-nav"><img src="icons/dpad-mono.tga" width="26" height="26" alt=""/><span>Navigate</span></span>
        <span id="system-status">Looking for games</span>
      </footer>

      <!-- Library -->
      <div id="rom-dialog" class="library-screen">
        <img class="library-background" src="background.tga" width="1920" height="1080" alt=""/>
        <span class="library-shade"></span>
        <span class="library-title">Your games</span>
        <span class="library-copy">Select a game to begin</span>
        <section class="library-list-panel">
          <img class="library-panel-chrome" src="chrome/dialog-panel.tga" width="820" height="720" alt=""/>
          <span class="library-panel-kicker">LIBRARY</span>
          <div id="rom-list-viewport"><div id="rom-list-track">
            <span id="rom-row-0" class="library-row library-row-0 focused"><img class="library-row-chrome base-chrome" src="chrome/library-row-normal.tga" width="760" height="78" alt=""/><img class="library-row-chrome focused-chrome" src="chrome/library-row-focused.tga" width="760" height="78" alt=""/><span id="rom-name-0" class="library-row-name"></span><span id="rom-format-0" class="library-row-meta"></span></span>
            <span id="rom-row-1" class="library-row library-row-1"><img class="library-row-chrome base-chrome" src="chrome/library-row-normal.tga" width="760" height="78" alt=""/><img class="library-row-chrome focused-chrome" src="chrome/library-row-focused.tga" width="760" height="78" alt=""/><span id="rom-name-1" class="library-row-name"></span><span id="rom-format-1" class="library-row-meta"></span></span>
            <span id="rom-row-2" class="library-row library-row-2"><img class="library-row-chrome base-chrome" src="chrome/library-row-normal.tga" width="760" height="78" alt=""/><img class="library-row-chrome focused-chrome" src="chrome/library-row-focused.tga" width="760" height="78" alt=""/><span id="rom-name-2" class="library-row-name"></span><span id="rom-format-2" class="library-row-meta"></span></span>
            <span id="rom-row-3" class="library-row library-row-3"><img class="library-row-chrome base-chrome" src="chrome/library-row-normal.tga" width="760" height="78" alt=""/><img class="library-row-chrome focused-chrome" src="chrome/library-row-focused.tga" width="760" height="78" alt=""/><span id="rom-name-3" class="library-row-name"></span><span id="rom-format-3" class="library-row-meta"></span></span>
            <span id="rom-row-4" class="library-row library-row-4"><img class="library-row-chrome base-chrome" src="chrome/library-row-normal.tga" width="760" height="78" alt=""/><img class="library-row-chrome focused-chrome" src="chrome/library-row-focused.tga" width="760" height="78" alt=""/><span id="rom-name-4" class="library-row-name"></span><span id="rom-format-4" class="library-row-meta"></span></span>
            <span id="rom-row-5" class="library-row library-row-5"><img class="library-row-chrome base-chrome" src="chrome/library-row-normal.tga" width="760" height="78" alt=""/><img class="library-row-chrome focused-chrome" src="chrome/library-row-focused.tga" width="760" height="78" alt=""/><span id="rom-name-5" class="library-row-name"></span><span id="rom-format-5" class="library-row-meta"></span></span>
            <span id="rom-row-6" class="library-row library-row-6"><img class="library-row-chrome base-chrome" src="chrome/library-row-normal.tga" width="760" height="78" alt=""/><img class="library-row-chrome focused-chrome" src="chrome/library-row-focused.tga" width="760" height="78" alt=""/><span id="rom-name-6" class="library-row-name"></span><span id="rom-format-6" class="library-row-meta"></span></span>
          </div></div>
          <span id="library-empty">No games found. Put them in the game files folder.</span>
          <span id="rom-scrollbar"><img class="scrollbar-track" src="chrome/scrollbar-track.tga" width="10" height="606" alt=""/><img id="rom-scrollbar-thumb" src="chrome/scrollbar-thumb.tga" width="10" height="110" alt=""/></span>
          <span id="library-position">0 OF 0</span>
        </section>
        <aside class="game-detail-panel">
          <img class="library-panel-chrome" src="chrome/dialog-panel.tga" width="820" height="720" alt=""/>
          <span class="detail-kicker">GAME DETAILS</span>
          <span id="game-detail-title">No game selected</span>
          <img id="game-cover" src="icons/ps5cemu.tga" width="288" height="288" alt=""/><span id="cover-caption"></span>
          <span class="game-detail-label game-detail-line-0">TITLE ID</span><span id="game-detail-format" class="game-detail-value game-detail-line-0">-</span>
          <span class="game-detail-label game-detail-line-1">VERSION</span><span id="game-detail-size" class="game-detail-value game-detail-line-1">-</span>
          <span class="game-detail-label game-detail-line-2">DLC</span><span id="game-detail-dlc" class="game-detail-value game-detail-line-2">-</span>
          <span class="game-path-label">FILES</span><span id="game-detail-path" class="game-path">-</span>
          <span id="game-packs-setting"><img src="chrome/dialog-row-normal.tga" width="736" height="94" alt=""/><span class="game-mode-label">Graphic packs</span><span id="game-packs-value">-</span></span>
          <span id="game-mode-hint"><img src="icons/triangle-mono.tga" width="26" height="26" alt=""/><span id="game-mode-hint-text">Choose this game's graphic packs.</span></span>
        </aside>
        <footer class="library-footer icon-footer"><span class="controller-hint lib-hint-select"><img class="hint-icon-0" src="icons/cross-mono.tga" width="26" height="26" alt=""/><span>Play</span></span><span class="controller-hint lib-hint-back"><img class="hint-icon-0" src="icons/circle-mono.tga" width="26" height="26" alt=""/><span>Back</span></span><span class="controller-hint lib-hint-browse"><img class="hint-icon-0" src="icons/updown-mono.tga" width="26" height="26" alt=""/><span>Browse games</span></span><span class="controller-hint lib-hint-mode"><img class="hint-icon-0" src="icons/triangle-mono.tga" width="26" height="26" alt=""/><span>Graphic packs</span></span></footer>
      </div>

      <!-- Graphic packs of one game -->
      <div id="packs-dialog" class="library-screen">
        <img class="library-background" src="background.tga" width="1920" height="1080" alt=""/>
        <span class="library-shade"></span>
        <span class="library-title">Graphic packs</span>
        <span id="packs-game" class="library-copy"></span>
        <section class="library-list-panel">
          <img class="library-panel-chrome" src="chrome/dialog-panel.tga" width="820" height="720" alt=""/>
          <span class="library-panel-kicker">COMMUNITY PACKS</span>
          <div id="packs-list-viewport">
            <span id="pack-row-0" class="library-row library-row-0"><img class="library-row-chrome base-chrome" src="chrome/library-row-normal.tga" width="760" height="78" alt=""/><img class="library-row-chrome focused-chrome" src="chrome/library-row-focused.tga" width="760" height="78" alt=""/><span id="pack-name-0" class="library-row-name pack-row-name"></span><span id="pack-state-0" class="library-row-meta pack-row-state"></span></span>
            <span id="pack-row-1" class="library-row library-row-1"><img class="library-row-chrome base-chrome" src="chrome/library-row-normal.tga" width="760" height="78" alt=""/><img class="library-row-chrome focused-chrome" src="chrome/library-row-focused.tga" width="760" height="78" alt=""/><span id="pack-name-1" class="library-row-name pack-row-name"></span><span id="pack-state-1" class="library-row-meta pack-row-state"></span></span>
            <span id="pack-row-2" class="library-row library-row-2"><img class="library-row-chrome base-chrome" src="chrome/library-row-normal.tga" width="760" height="78" alt=""/><img class="library-row-chrome focused-chrome" src="chrome/library-row-focused.tga" width="760" height="78" alt=""/><span id="pack-name-2" class="library-row-name pack-row-name"></span><span id="pack-state-2" class="library-row-meta pack-row-state"></span></span>
            <span id="pack-row-3" class="library-row library-row-3"><img class="library-row-chrome base-chrome" src="chrome/library-row-normal.tga" width="760" height="78" alt=""/><img class="library-row-chrome focused-chrome" src="chrome/library-row-focused.tga" width="760" height="78" alt=""/><span id="pack-name-3" class="library-row-name pack-row-name"></span><span id="pack-state-3" class="library-row-meta pack-row-state"></span></span>
            <span id="pack-row-4" class="library-row library-row-4"><img class="library-row-chrome base-chrome" src="chrome/library-row-normal.tga" width="760" height="78" alt=""/><img class="library-row-chrome focused-chrome" src="chrome/library-row-focused.tga" width="760" height="78" alt=""/><span id="pack-name-4" class="library-row-name pack-row-name"></span><span id="pack-state-4" class="library-row-meta pack-row-state"></span></span>
            <span id="pack-row-5" class="library-row library-row-5"><img class="library-row-chrome base-chrome" src="chrome/library-row-normal.tga" width="760" height="78" alt=""/><img class="library-row-chrome focused-chrome" src="chrome/library-row-focused.tga" width="760" height="78" alt=""/><span id="pack-name-5" class="library-row-name pack-row-name"></span><span id="pack-state-5" class="library-row-meta pack-row-state"></span></span>
            <span id="pack-row-6" class="library-row library-row-6"><img class="library-row-chrome base-chrome" src="chrome/library-row-normal.tga" width="760" height="78" alt=""/><img class="library-row-chrome focused-chrome" src="chrome/library-row-focused.tga" width="760" height="78" alt=""/><span id="pack-name-6" class="library-row-name pack-row-name"></span><span id="pack-state-6" class="library-row-meta pack-row-state"></span></span>
          </div>
          <span id="packs-empty">No graphic packs for this game.</span>
          <span id="packs-position">0 OF 0</span>
        </section>
        <aside class="game-detail-panel">
          <img class="library-panel-chrome" src="chrome/dialog-panel.tga" width="820" height="720" alt=""/>
          <span class="detail-kicker">THIS PACK</span>
          <span id="pack-detail-title"></span>
          <span class="files-label files-line-0">CATEGORY</span><span id="pack-detail-category" class="files-value files-line-0 ready"></span>
          <span class="files-label files-line-1">PRESET</span><span id="pack-detail-preset" class="files-value files-line-1 ready"></span>
          <span class="about-divider files-divider-0"></span>
          <span id="pack-detail-description"></span>
        </aside>
        <footer class="library-footer icon-footer"><span class="controller-hint lib-hint-select"><img class="hint-icon-0" src="icons/cross-mono.tga" width="26" height="26" alt=""/><span>On / off</span></span><span class="controller-hint lib-hint-back"><img class="hint-icon-0" src="icons/circle-mono.tga" width="26" height="26" alt=""/><span>Back</span></span><span class="controller-hint lib-hint-browse"><img class="hint-icon-0" src="icons/updown-mono.tga" width="26" height="26" alt=""/><span>Browse packs</span></span><span class="controller-hint lib-hint-mode"><img class="hint-icon-0" src="icons/leftright-mono.tga" width="26" height="26" alt=""/><span>Preset</span></span></footer>
      </div>

      <!-- Settings -->
      <div id="settings-dialog" class="settings-screen">
        <img class="library-background" src="background.tga" width="1920" height="1080" alt=""/>
        <span class="library-shade"></span>
        <span class="library-title">Settings</span><span class="library-copy">Fine-tune your experience</span>
        <section class="settings-list-panel">
        <img class="library-panel-chrome" src="chrome/dialog-panel.tga" width="820" height="720" alt=""/>
        <span class="library-panel-kicker">PREFERENCES</span>
        <span id="settings-row-0" class="dialog-row dialog-row-0 focused"><img class="dialog-row-chrome base-chrome" src="chrome/dialog-row-normal.tga" width="736" height="94" alt=""/><img class="dialog-row-chrome focused-chrome" src="chrome/dialog-row-focused.tga" width="736" height="94" alt=""/><span>Video</span></span>
        <span id="settings-row-1" class="dialog-row dialog-row-1"><img class="dialog-row-chrome base-chrome" src="chrome/dialog-row-normal.tga" width="736" height="94" alt=""/><img class="dialog-row-chrome focused-chrome" src="chrome/dialog-row-focused.tga" width="736" height="94" alt=""/><span>Audio</span></span>
        <span id="settings-row-2" class="dialog-row dialog-row-2"><img class="dialog-row-chrome base-chrome" src="chrome/dialog-row-normal.tga" width="736" height="94" alt=""/><img class="dialog-row-chrome focused-chrome" src="chrome/dialog-row-focused.tga" width="736" height="94" alt=""/><span>Controls</span></span>
        <span id="settings-row-3" class="dialog-row dialog-row-3"><img class="dialog-row-chrome base-chrome" src="chrome/dialog-row-normal.tga" width="736" height="94" alt=""/><img class="dialog-row-chrome focused-chrome" src="chrome/dialog-row-focused.tga" width="736" height="94" alt=""/><span>Diagnostics</span></span>
        <span id="settings-row-4" class="dialog-row dialog-row-4"><img class="dialog-row-chrome base-chrome" src="chrome/dialog-row-normal.tga" width="736" height="94" alt=""/><img class="dialog-row-chrome focused-chrome" src="chrome/dialog-row-focused.tga" width="736" height="94" alt=""/><span>Game files</span></span>
        </section>
        <aside class="settings-detail-panel"><img class="library-panel-chrome" src="chrome/dialog-panel.tga" width="820" height="720" alt=""/>
          <span class="detail-kicker">ON THIS CONSOLE</span>
          <span class="settings-detail-title">Make it yours.</span>
          <span class="settings-detail-copy">Adjust the essentials without leaving your library behind.</span>
          <span class="settings-detail-label settings-detail-one">VIDEO</span><span class="settings-detail-value settings-detail-one">Upscaling filter, 120 Hz, overlay</span>
          <span class="settings-detail-label settings-detail-two">AUDIO</span><span class="settings-detail-value settings-detail-two">Game volume</span>
          <span class="settings-detail-label settings-detail-three">CONTROLS</span><span class="settings-detail-value settings-detail-three">Shortcuts and vibration</span>
          <span class="settings-detail-label settings-detail-four">DIAGNOSTICS</span><span class="settings-detail-value settings-detail-four">Jailbreak, JIT and log files</span>
          <span class="settings-detail-label settings-detail-five">GAME FILES</span><span class="settings-detail-value settings-detail-five">Folder for your Wii U games</span>
        </aside>
        <footer class="library-footer icon-footer"><span class="controller-hint lib-hint-select"><img class="hint-icon-0" src="icons/cross-mono.tga" width="26" height="26" alt=""/><span>Select</span></span><span class="controller-hint lib-hint-back"><img class="hint-icon-0" src="icons/circle-mono.tga" width="26" height="26" alt=""/><span>Back</span></span><span class="controller-hint lib-hint-browse"><img class="hint-icon-0" src="icons/updown-mono.tga" width="26" height="26" alt=""/><span>Browse settings</span></span></footer>
      </div>

      <!-- Settings > Game files: the folder browser -->
      <div id="files-dialog" class="library-screen">
        <img class="library-background" src="background.tga" width="1920" height="1080" alt=""/>
        <span class="library-shade"></span>
        <span class="library-title">Game files</span>
        <span class="library-copy">Choose the folder that holds your Wii U games</span>
        <section class="library-list-panel">
          <img class="library-panel-chrome" src="chrome/dialog-panel.tga" width="820" height="720" alt=""/>
          <span class="library-panel-kicker">FOLDERS</span>
          <span id="files-path"></span>
          <div id="files-list-viewport">
            <span id="files-row-0" class="library-row library-row-0 files-row"><img class="library-row-chrome base-chrome" src="chrome/library-row-normal.tga" width="760" height="78" alt=""/><img class="library-row-chrome focused-chrome" src="chrome/library-row-focused.tga" width="760" height="78" alt=""/><img class="files-icon files-icon-folder" src="icons/folder.tga" width="40" height="32" alt=""/><img class="files-icon files-icon-up" src="icons/folder-up.tga" width="40" height="32" alt=""/><span id="files-name-0" class="library-row-name files-row-name"></span></span>
            <span id="files-row-1" class="library-row library-row-1 files-row"><img class="library-row-chrome base-chrome" src="chrome/library-row-normal.tga" width="760" height="78" alt=""/><img class="library-row-chrome focused-chrome" src="chrome/library-row-focused.tga" width="760" height="78" alt=""/><img class="files-icon files-icon-folder" src="icons/folder.tga" width="40" height="32" alt=""/><img class="files-icon files-icon-up" src="icons/folder-up.tga" width="40" height="32" alt=""/><span id="files-name-1" class="library-row-name files-row-name"></span></span>
            <span id="files-row-2" class="library-row library-row-2 files-row"><img class="library-row-chrome base-chrome" src="chrome/library-row-normal.tga" width="760" height="78" alt=""/><img class="library-row-chrome focused-chrome" src="chrome/library-row-focused.tga" width="760" height="78" alt=""/><img class="files-icon files-icon-folder" src="icons/folder.tga" width="40" height="32" alt=""/><img class="files-icon files-icon-up" src="icons/folder-up.tga" width="40" height="32" alt=""/><span id="files-name-2" class="library-row-name files-row-name"></span></span>
            <span id="files-row-3" class="library-row library-row-3 files-row"><img class="library-row-chrome base-chrome" src="chrome/library-row-normal.tga" width="760" height="78" alt=""/><img class="library-row-chrome focused-chrome" src="chrome/library-row-focused.tga" width="760" height="78" alt=""/><img class="files-icon files-icon-folder" src="icons/folder.tga" width="40" height="32" alt=""/><img class="files-icon files-icon-up" src="icons/folder-up.tga" width="40" height="32" alt=""/><span id="files-name-3" class="library-row-name files-row-name"></span></span>
            <span id="files-row-4" class="library-row library-row-4 files-row"><img class="library-row-chrome base-chrome" src="chrome/library-row-normal.tga" width="760" height="78" alt=""/><img class="library-row-chrome focused-chrome" src="chrome/library-row-focused.tga" width="760" height="78" alt=""/><img class="files-icon files-icon-folder" src="icons/folder.tga" width="40" height="32" alt=""/><img class="files-icon files-icon-up" src="icons/folder-up.tga" width="40" height="32" alt=""/><span id="files-name-4" class="library-row-name files-row-name"></span></span>
            <span id="files-row-5" class="library-row library-row-5 files-row"><img class="library-row-chrome base-chrome" src="chrome/library-row-normal.tga" width="760" height="78" alt=""/><img class="library-row-chrome focused-chrome" src="chrome/library-row-focused.tga" width="760" height="78" alt=""/><img class="files-icon files-icon-folder" src="icons/folder.tga" width="40" height="32" alt=""/><img class="files-icon files-icon-up" src="icons/folder-up.tga" width="40" height="32" alt=""/><span id="files-name-5" class="library-row-name files-row-name"></span></span>
          </div>
          <span id="files-empty">No folders here.</span>
          <span id="files-position">0 OF 0</span>
        </section>
        <aside class="game-detail-panel">
          <img class="library-panel-chrome" src="chrome/dialog-panel.tga" width="820" height="720" alt=""/>
          <span class="detail-kicker">THIS FOLDER</span>
          <span id="files-current"></span>
          <span class="files-label files-line-0">GAMES</span><span id="files-games" class="files-value files-line-0"></span>
          <span class="files-label files-line-1">KEYS.TXT</span><span id="files-keys" class="files-value files-line-1"></span>
          <span class="files-label files-line-2">IN USE</span><span id="files-in-use" class="files-value files-line-2"></span>
          <span class="about-divider files-divider-0"></span>
          <span id="files-message"></span>
        </aside>
        <footer class="library-footer icon-footer"><span class="controller-hint files-hint-open"><img class="hint-icon-0" src="icons/cross-mono.tga" width="26" height="26" alt=""/><span>Open</span></span><span class="controller-hint files-hint-back"><img class="hint-icon-0" src="icons/circle-mono.tga" width="26" height="26" alt=""/><span>Back</span></span><span class="controller-hint files-hint-use"><img class="hint-icon-0" src="icons/triangle-mono.tga" width="26" height="26" alt=""/><span>Use this folder</span></span><span class="controller-hint files-hint-page"><img class="hint-icon-0" src="icons/l1-mono.tga" width="26" height="26" alt=""/><img class="hint-icon-1" src="icons/r1-mono.tga" width="26" height="26" alt=""/><span class="files-page-label">Page</span></span></footer>
      </div>

      <!-- Settings > Video -->
      <div id="video-dialog" class="dialog"><div class="dialog-panel">
        <img class="dialog-panel-chrome" src="chrome/modal-panel.tga" width="820" height="720" alt=""/>
        <span class="dialog-title">Video</span>
        <span class="dialog-copy">Applies to the next game you start.</span>
        <span id="video-row-0" class="dialog-row dialog-row-0"><img class="dialog-row-chrome base-chrome" src="chrome/dialog-row-normal.tga" width="736" height="94" alt=""/><img class="dialog-row-chrome focused-chrome" src="chrome/dialog-row-focused.tga" width="736" height="94" alt=""/><span id="video-output">Upscaling to 4K: Bicubic</span></span>
        <span id="video-row-1" class="dialog-row dialog-row-1"><img class="dialog-row-chrome base-chrome" src="chrome/dialog-row-normal.tga" width="736" height="94" alt=""/><img class="dialog-row-chrome focused-chrome" src="chrome/dialog-row-focused.tga" width="736" height="94" alt=""/><span id="video-hfr">120 Hz output: Off</span></span>
        <span id="video-row-2" class="dialog-row dialog-row-2"><img class="dialog-row-chrome base-chrome" src="chrome/dialog-row-normal.tga" width="736" height="94" alt=""/><img class="dialog-row-chrome focused-chrome" src="chrome/dialog-row-focused.tga" width="736" height="94" alt=""/><span id="video-overlay">Performance overlay: Off</span></span>
        <span class="dialog-hint">UP / DOWN Select  /  X or LEFT / RIGHT Change  /  O Back</span>
      </div></div>

      <!-- Settings > Audio -->
      <div id="audio-dialog" class="dialog"><div class="dialog-panel">
        <img class="dialog-panel-chrome" src="chrome/modal-panel.tga" width="820" height="720" alt=""/>
        <span class="dialog-title">Audio</span>
        <span class="dialog-copy">The TV sound of your games; the PS5's own volume is unchanged.</span>
        <span id="audio-row-0" class="dialog-row dialog-row-0 focused"><img class="dialog-row-chrome base-chrome" src="chrome/dialog-row-normal.tga" width="736" height="94" alt=""/><img class="dialog-row-chrome focused-chrome" src="chrome/dialog-row-focused.tga" width="736" height="94" alt=""/><span id="audio-volume">Game volume: 100%</span></span>
        <span class="dialog-hint">LEFT / RIGHT Change  /  O Back</span>
      </div></div>

      <!-- Settings > Controls -->
      <div id="controls-dialog" class="dialog"><div class="dialog-panel">
        <img class="dialog-panel-chrome" src="chrome/modal-panel.tga" width="820" height="720" alt=""/>
        <span class="dialog-title">Controls</span>
        <span class="dialog-copy">Your DualSense is the Wii U GamePad; more players get Pro Controllers.</span>
        <div class="settings-details">Touchpad: a cursor on the GamePad's screen; click to touch.<br/>Touchpad click + Options: the in-game menu.<br/>Touchpad click + L1: TV or GamePad as the main screen.<br/>Touchpad click + R1: the other screen in a corner.</div>
        <span id="controls-row-0" class="dialog-row settings-low focused"><img class="dialog-row-chrome base-chrome" src="chrome/dialog-row-normal.tga" width="736" height="94" alt=""/><img class="dialog-row-chrome focused-chrome" src="chrome/dialog-row-focused.tga" width="736" height="94" alt=""/><span id="controls-rumble">Vibration: On</span></span>
        <span class="dialog-hint">X Change  /  O Back</span>
      </div></div>

      <!-- Settings > Diagnostics -->
      <div id="diagnostics-dialog" class="dialog"><div class="dialog-panel">
        <img class="dialog-panel-chrome" src="chrome/modal-panel.tga" width="820" height="720" alt=""/>
        <span class="dialog-title">Diagnostics</span>
        <span class="dialog-copy">Attach the log files when you report a problem.</span>
        <div id="setup-details" class="settings-details"></div>
        <span class="dialog-hint">O Back</span>
      </div></div>

      <!-- About -->
      <div id="about-dialog" class="library-screen about-screen">
        <img class="library-background" src="background.tga" width="1920" height="1080" alt=""/>
        <span class="library-shade"></span>
        <span class="library-title">About PS5Cemu</span>
        <span class="library-copy">Credits and setup</span>
        <section class="about-credit-panel">
          <img class="library-panel-chrome" src="chrome/dialog-panel.tga" width="820" height="720" alt=""/>
          <span class="detail-kicker">PROJECT CREDITS</span>
          <span class="about-lead about-eden-lead">Powered by Cemu</span>
          <span class="about-body about-eden">All credit for the Wii U emulator goes to the Cemu team and its contributors.</span>
          <span class="about-link about-eden-link">cemu.info</span>
          <span class="about-divider about-divider-vulkan"></span>
          <span class="about-subhead about-vulkan-head">THANKS</span>
          <span class="about-body about-vulkan">Mihawk-99 and mpereiraesaa (RADV on the PS5), BlackBearReloaded (ProsperoEden's launcher, the app boilerplate), Swordpdf (PS5SX2), John Tornblom (payload SDK), the graphic pack authors.</span>
          <span class="about-divider about-divider-port"></span>
          <span class="about-subhead about-port-head">PS5 EDITION</span>
          <span class="about-body about-port">An unofficial port. Not affiliated with the Cemu team, Nintendo or Sony.</span>
        </section>
        <aside class="about-setup-panel">
          <img class="library-panel-chrome" src="chrome/dialog-panel.tga" width="820" height="720" alt=""/>
          <span class="detail-kicker">GETTING STARTED</span>
          <span class="about-lead">Supply your own files</span>
          <span class="about-setup-label about-keys">GAMES</span><span id="about-games-path" class="about-setup-path about-keys">/data/ps5cemu/games</span>
          <span class="about-setup-label about-firmware">KEYS</span><span id="about-keys-path" class="about-setup-path about-firmware">/data/ps5cemu/keys.txt</span>
          <span class="about-setup-label about-games">SAVES</span><span id="about-mlc-path" class="about-setup-path about-games">/data/ps5cemu/mlc01</span>
          <span class="about-divider about-setup-divider"></span>
          <span class="about-note">Dump your games from your own Wii U (.wua, .wud, .wux, or a folder with code, content and meta).</span>
        </aside>
        <footer class="library-footer icon-footer"><span class="controller-hint lib-hint-select"><img class="hint-icon-0" src="icons/circle-mono.tga" width="26" height="26" alt=""/><span>Back</span></span></footer>
      </div>

      <!-- Starting a game -->
      <div id="loading-screen" class="library-screen">
        <img class="library-background" src="background.tga" width="1920" height="1080" alt=""/>
        <span class="library-shade"></span>
        <img id="loading-cover" src="icons/ps5cemu.tga" width="288" height="288" alt=""/>
        <span id="loading-title"></span>
        <span id="loading-caption">Starting</span>
      </div>
    </div>
  </body>
</rml>
