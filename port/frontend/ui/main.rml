      <!-- About -->
      <div id="about-dialog" class="library-screen about-screen">
        <span class="library-shade"></span>
        <span class="library-title">About PS5Cemu</span>
        <span class="library-copy">Credits and setup</span>
        <section class="about-credit-panel">
          <img class="library-panel-chrome" src="chrome/dialog-panel.tga" width="820" height="720" alt=""/>
          <span class="detail-kicker">PROJECT CREDITS</span>
          <span class="about-lead about-eden-lead">Powered by Cemu</span>
          <span class="about-body about-eden">All credit for the Wii U emulator goes to the Cemu team and its contributors.</span>
          <span class="about-link about-eden-link">cemu.info</span>
          <span class="about-divider about-divider-vulkan"></span>
          <span class="about-subhead about-vulkan-head">THANKS</span>
          <span class="about-body about-vulkan">Mihawk-99 and mpereiraesaa (RADV on the PS5), BlackBearReloaded (ProsperoEden's launcher, the app boilerplate), Swordpdf (PS5SX2), John Tornblom (payload SDK), Dimok (the Homebrew Launcher), the graphic pack authors.</span>
          <span class="about-divider about-divider-port"></span>
          <span class="about-subhead about-port-head">PS5 EDITION</span>
          <span class="about-body about-port">An unofficial port. Not affiliated with the Cemu team, Nintendo or Sony.</span>
        </section>
        <aside class="about-setup-panel">
          <img class="library-panel-chrome" src="chrome/dialog-panel.tga" width="820" height="720" alt=""/>
          <span class="detail-kicker">GETTING STARTED</span>
          <span class="about-lead">Supply your own files</span>
          <span class="about-setup-label about-keys">GAMES</span><span id="about-games-path" class="about-setup-path about-keys">/data/ps5cemu/games</span>
          <span class="about-setup-label about-firmware">KEYS</span><span id="about-keys-path" class="about-setup-path about-firmware">/data/ps5cemu/keys.txt</span>
          <span class="about-setup-label about-games">SAVES</span><span id="about-mlc-path" class="about-setup-path about-games">/data/ps5cemu/mlc01</span>
          <span class="about-divider about-setup-divider"></span>
          <span class="about-note">Dump your games from your own Wii U (.wua, .wud, .wux, or a folder with code, content and meta).</span>
        </aside>
        <footer class="hints"><span class="hint"><img src="icons/circle-mono.tga" width="26" height="26" alt=""/><span class="hint-text">Back</span></span></footer>
      </div>

      <!-- A dropdown's choices, over the right-hand panel -->
      <div id="picker">
        <div class="picker-panel">
          <img class="dialog-panel-chrome" src="chrome/modal-panel.tga" width="820" height="720" alt=""/>
          <span id="picker-kicker" class="detail-kicker"></span>
          <span id="picker-title" class="detail-title"></span>
          <div id="picker-viewport">
            <span id="picker-row-0" class="library-row library-row-0"><img class="library-row-chrome base-chrome" src="chrome/library-row-normal.tga" width="760" height="78" alt=""/><img class="library-row-chrome focused-chrome" src="chrome/library-row-focused.tga" width="760" height="78" alt=""/><span id="picker-name-0" class="library-row-name picker-name"></span><span id="picker-mark-0" class="library-row-meta picker-mark"></span></span>
            <span id="picker-row-1" class="library-row library-row-1"><img class="library-row-chrome base-chrome" src="chrome/library-row-normal.tga" width="760" height="78" alt=""/><img class="library-row-chrome focused-chrome" src="chrome/library-row-focused.tga" width="760" height="78" alt=""/><span id="picker-name-1" class="library-row-name picker-name"></span><span id="picker-mark-1" class="library-row-meta picker-mark"></span></span>
            <span id="picker-row-2" class="library-row library-row-2"><img class="library-row-chrome base-chrome" src="chrome/library-row-normal.tga" width="760" height="78" alt=""/><img class="library-row-chrome focused-chrome" src="chrome/library-row-focused.tga" width="760" height="78" alt=""/><span id="picker-name-2" class="library-row-name picker-name"></span><span id="picker-mark-2" class="library-row-meta picker-mark"></span></span>
            <span id="picker-row-3" class="library-row library-row-3"><img class="library-row-chrome base-chrome" src="chrome/library-row-normal.tga" width="760" height="78" alt=""/><img class="library-row-chrome focused-chrome" src="chrome/library-row-focused.tga" width="760" height="78" alt=""/><span id="picker-name-3" class="library-row-name picker-name"></span><span id="picker-mark-3" class="library-row-meta picker-mark"></span></span>
            <span id="picker-row-4" class="library-row library-row-4"><img class="library-row-chrome base-chrome" src="chrome/library-row-normal.tga" width="760" height="78" alt=""/><img class="library-row-chrome focused-chrome" src="chrome/library-row-focused.tga" width="760" height="78" alt=""/><span id="picker-name-4" class="library-row-name picker-name"></span><span id="picker-mark-4" class="library-row-meta picker-mark"></span></span>
            <span id="picker-row-5" class="library-row library-row-5"><img class="library-row-chrome base-chrome" src="chrome/library-row-normal.tga" width="760" height="78" alt=""/><img class="library-row-chrome focused-chrome" src="chrome/library-row-focused.tga" width="760" height="78" alt=""/><span id="picker-name-5" class="library-row-name picker-name"></span><span id="picker-mark-5" class="library-row-meta picker-mark"></span></span>
          </div>
          <div class="picker-hints"><span class="hint"><img src="icons/cross-mono.tga" width="26" height="26" alt=""/><span class="hint-text">Choose</span></span><span class="hint"><img src="icons/circle-mono.tga" width="26" height="26" alt=""/><span class="hint-text">Cancel</span></span></div>
          <span id="picker-position"></span>
        </div>
      </div>

      <!-- Starting a game -->
      <div id="loading-screen" class="library-screen">
        <span class="library-shade"></span>
        <img id="loading-cover" src="icons/ps5cemu.tga" width="288" height="288" alt=""/>
        <span id="loading-title"></span>
        <span id="loading-caption">Starting</span>
      </div>
    </div>
  </body>
</rml>
