+                             u32 height, bool inside_render_pass);
+#endif
     void DrawBottomScreen(const Layout::FramebufferLayout& layout,
                           const Common::Rectangle<u32>& bottom_screen);
 
diff --git a/src/video_core/renderer_vulkan/vk_frontend_overlay.h b/src/video_core/renderer_vulkan/vk_frontend_overlay.h
new file mode 100644
index 000000000..e403dea67
--- /dev/null
+++ b/src/video_core/renderer_vulkan/vk_frontend_overlay.h
@@ -0,0 +1,38 @@
+// Copyright 2026 Citra Emulator Project / Azahar Emulator Project
+// Licensed under GPLv2 or any later version
+// Refer to the license.txt file included.
+
+#pragma once
+
+#ifdef __PROSPERO__
+
+#include "common/common_types.h"
+#include "video_core/renderer_vulkan/vk_common.h"
+
+namespace Vulkan {
+
+/// What a frontend draws over the screens with (the PS5's in-game menu): the device, and the frame
+/// being recorded, before the screens' render pass begins (inside_render_pass false: for uploads)
+/// and in it, after the screens and the cursor (true).
+struct FrontendOverlayTarget {
+    VkInstance instance;
+    VkPhysicalDevice physical_device;
+    VkDevice device;
+    u32 queue_family;
+    VkQueue queue;
+    VkRenderPass render_pass;
+    u32 image_count;
+    VkCommandBuffer command_buffer;
+    u32 width;
+    u32 height;
+    bool inside_render_pass;
+};
+using FrontendOverlay = void (*)(const FrontendOverlayTarget& target);
+
+/// Called where the renderer records its commands (its worker thread, when it has one); null for
+/// none.
+void SetFrontendOverlay(FrontendOverlay overlay);
+
+} // namespace Vulkan
+
+#endif
