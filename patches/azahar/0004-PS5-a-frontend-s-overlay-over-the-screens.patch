diff --git a/src/video_core/renderer_vulkan/renderer_vulkan.cpp b/src/video_core/renderer_vulkan/renderer_vulkan.cpp
index 5221fdf15..a1afa28b6 100644
--- a/src/video_core/renderer_vulkan/renderer_vulkan.cpp
+++ b/src/video_core/renderer_vulkan/renderer_vulkan.cpp
@@ -2,6 +2,7 @@
 // Licensed under GPLv2 or any later version
 // Refer to the license.txt file included.
 
+#include <atomic>
 #include "common/assert.h"
 #include "common/logging/log.h"
 #include "common/memory_detect.h"
@@ -185,6 +186,37 @@ void RendererVulkan::PrepareRendertarget() {
     }
 }
 
+#ifdef __PROSPERO__
+namespace {
+std::atomic<FrontendOverlay> frontend_overlay{nullptr};
+} // Anonymous namespace
+
+void SetFrontendOverlay(FrontendOverlay overlay) {
+    frontend_overlay = overlay;
+}
+
+void RendererVulkan::DrawFrontendOverlay(vk::CommandBuffer cmdbuf, vk::RenderPass renderpass,
+                                         u32 width, u32 height, bool inside_render_pass) {
+    const auto overlay = frontend_overlay.load();
+    if (!overlay) {
+        return;
+    }
+    overlay(FrontendOverlayTarget{
+        .instance = static_cast<VkInstance>(instance.GetInstance()),
+        .physical_device = static_cast<VkPhysicalDevice>(instance.GetPhysicalDevice()),
+        .device = static_cast<VkDevice>(instance.GetDevice()),
+        .queue_family = instance.GetGraphicsQueueFamilyIndex(),
+        .queue = static_cast<VkQueue>(instance.GetGraphicsQueue()),
+        .render_pass = static_cast<VkRenderPass>(renderpass),
+        .image_count = main_present_window.ImageCount(),
+        .command_buffer = static_cast<VkCommandBuffer>(cmdbuf),
+        .width = width,
+        .height = height,
+        .inside_render_pass = inside_render_pass,
+    });
+}
+#endif
+
 void RendererVulkan::PrepareDraw(Frame* frame, const Layout::FramebufferLayout& layout) {
     const auto sampler = present_samplers[!Settings::values.filter_mode.GetValue()];
     const auto present_set = present_heap.Commit();
@@ -228,6 +260,9 @@ void RendererVulkan::PrepareDraw(Frame* frame, const Layout::FramebufferLayout&
             .pClearValues = &clear,
         };
 
+#ifdef __PROSPERO__
+        DrawFrontendOverlay(cmdbuf, renderpass, frame->width, frame->height, false);
+#endif
         cmdbuf.beginRenderPass(renderpass_begin_info, vk::SubpassContents::eInline);
         cmdbuf.bindPipeline(vk::PipelineBindPoint::eGraphics, present_pipelines[index]);
         cmdbuf.bindDescriptorSets(vk::PipelineBindPoint::eGraphics, layout, 0, present_set, {});
@@ -1060,6 +1095,12 @@ void RendererVulkan::DrawScreens(Frame* frame, const Layout::FramebufferLayout&
 
     DrawCursor(layout);
 
+#ifdef __PROSPERO__
+    scheduler.Record([this, renderpass = main_present_window.Renderpass(), width = frame->width,
+                      height = frame->height](vk::CommandBuffer cmdbuf) {
+        DrawFrontendOverlay(cmdbuf, renderpass, width, height, true);
+    });
+#endif
     scheduler.Record([](vk::CommandBuffer cmdbuf) { cmdbuf.endRenderPass(); });
 }
 
