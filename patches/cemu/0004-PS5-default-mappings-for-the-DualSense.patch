From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ps5cemu <ps5cemu@localhost>
Date: Thu, 1 Oct 2026 06:52:42 +0000
Subject: [PATCH] PS5: default mappings for the DualSense

A new GamePad or Pro Controller profile on the DualSense gets the mapping
Cemu gives an SDL gamepad: the DualSense controller numbers its buttons
the same way (A on Circle, B on Cross, X on Triangle, Y on Square, as on a
Wii U). Without it the first start had no buttons mapped.
---
 src/input/emulated/ProController.cpp  | 40 +++++++++++++++++++++++++++
 src/input/emulated/VPADController.cpp | 40 +++++++++++++++++++++++++++
 2 files changed, 80 insertions(+)

diff --git a/src/input/emulated/ProController.cpp b/src/input/emulated/ProController.cpp
index bb584c1..fad54c7 100644
--- a/src/input/emulated/ProController.cpp
+++ b/src/input/emulated/ProController.cpp
@@ -222,6 +222,46 @@ bool ProController::set_default_mapping(const std::shared_ptr<ControllerBase>& c
 		}
 		break;
 	}
+#endif
+#if defined(CEMU_PS5)
+	case InputAPI::PS5Pad:
+	{
+		// the DualSense numbers its buttons as SDL numbers a gamepad's (ps5cemu/port/cemu/PS5PadController.h)
+		mapping =
+		{
+			{kButtonId_A, kButton1},
+			{kButtonId_B, kButton0},
+			{kButtonId_X, kButton3},
+			{kButtonId_Y, kButton2},
+
+			{kButtonId_L, kButton9},
+			{kButtonId_R, kButton10},
+			{kButtonId_ZL, kTriggerXP},
+			{kButtonId_ZR, kTriggerYP},
+
+			{kButtonId_Plus, kButton6},
+			{kButtonId_Minus, kButton4},
+
+			{kButtonId_Up, kButton11},
+			{kButtonId_Down, kButton12},
+			{kButtonId_Left, kButton13},
+			{kButtonId_Right, kButton14},
+
+			{kButtonId_StickL, kButton7},
+			{kButtonId_StickR, kButton8},
+
+			{kButtonId_StickL_Up, kAxisYN},
+			{kButtonId_StickL_Down, kAxisYP},
+			{kButtonId_StickL_Left, kAxisXN},
+			{kButtonId_StickL_Right, kAxisXP},
+
+			{kButtonId_StickR_Up, kRotationYN},
+			{kButtonId_StickR_Down, kRotationYP},
+			{kButtonId_StickR_Left, kRotationXN},
+			{kButtonId_StickR_Right, kRotationXP},
+		};
+		break;
+	}
 #endif
 	case InputAPI::XInput:
 	{
diff --git a/src/input/emulated/VPADController.cpp b/src/input/emulated/VPADController.cpp
index a791c5f..1d7de20 100644
--- a/src/input/emulated/VPADController.cpp
+++ b/src/input/emulated/VPADController.cpp
@@ -637,6 +637,46 @@ bool VPADController::set_default_mapping(const std::shared_ptr<ControllerBase>&
 		}
 		break;
 	}
+#endif
+#if defined(CEMU_PS5)
+	case InputAPI::PS5Pad:
+	{
+		// the DualSense numbers its buttons as SDL numbers a gamepad's (ps5cemu/port/cemu/PS5PadController.h)
+		mapping =
+		{
+			{kButtonId_A, kButton1},
+			{kButtonId_B, kButton0},
+			{kButtonId_X, kButton3},
+			{kButtonId_Y, kButton2},
+
+			{kButtonId_L, kButton9},
+			{kButtonId_R, kButton10},
+			{kButtonId_ZL, kTriggerXP},
+			{kButtonId_ZR, kTriggerYP},
+
+			{kButtonId_Plus, kButton6},
+			{kButtonId_Minus, kButton4},
+
+			{kButtonId_Up, kButton11},
+			{kButtonId_Down, kButton12},
+			{kButtonId_Left, kButton13},
+			{kButtonId_Right, kButton14},
+
+			{kButtonId_StickL, kButton7},
+			{kButtonId_StickR, kButton8},
+
+			{kButtonId_StickL_Up, kAxisYN},
+			{kButtonId_StickL_Down, kAxisYP},
+			{kButtonId_StickL_Left, kAxisXN},
+			{kButtonId_StickL_Right, kAxisXP},
+
+			{kButtonId_StickR_Up, kRotationYN},
+			{kButtonId_StickR_Down, kRotationYP},
+			{kButtonId_StickR_Left, kRotationXN},
+			{kButtonId_StickR_Right, kRotationXP},
+		};
+		break;
+	}
 #endif
 	case InputAPI::XInput:
 	{
