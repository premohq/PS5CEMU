diff --git a/src/Cafe/HW/Latte/Renderer/Vulkan/VulkanAPI.cpp b/src/Cafe/HW/Latte/Renderer/Vulkan/VulkanAPI.cpp
index b7dc500..e10dd96 100644
--- a/src/Cafe/HW/Latte/Renderer/Vulkan/VulkanAPI.cpp
+++ b/src/Cafe/HW/Latte/Renderer/Vulkan/VulkanAPI.cpp
@@ -142,6 +142,47 @@ bool InitializeDeviceVulkan(VkDevice device)
 	return true;
 }
 
+#elif defined(CEMU_PS5)
+
+// The PS5 has no Vulkan loader: RADV is linked into the title, and the port hands out its
+// vkGetInstanceProcAddr (ps5cemu/port/cemu/VulkanPS5.cpp).
+PFN_vkVoidFunction PS5_VulkanGetGlobalProc(const char* name);
+
+bool InitializeGlobalVulkan()
+{
+	if(g_vulkan_available)
+		return true;
+
+	#define VKFUNC_INIT
+	#include "Cafe/HW/Latte/Renderer/Vulkan/VulkanAPI.h"
+
+	if(!vkGetInstanceProcAddr || !vkEnumerateInstanceVersion)
+	{
+		cemuLog_log(LogType::Force, "The PS5 Vulkan driver did not provide its global commands");
+		return false;
+	}
+
+	g_vulkan_available = true;
+	return true;
+}
+
+bool InitializeInstanceVulkan(VkInstance instance)
+{
+	#define VKFUNC_INSTANCE_INIT
+	#include "Cafe/HW/Latte/Renderer/Vulkan/VulkanAPI.h"
+
+	// a global command per Cemu's table, but only an instance can give it out
+	vkGetDeviceProcAddr = (PFN_vkGetDeviceProcAddr)vkGetInstanceProcAddr(instance, "vkGetDeviceProcAddr");
+	return vkGetDeviceProcAddr != nullptr;
+}
+
+bool InitializeDeviceVulkan(VkDevice device)
+{
+	#define VKFUNC_DEVICE_INIT
+	#include "Cafe/HW/Latte/Renderer/Vulkan/VulkanAPI.h"
+	return true;
+}
+
 #else
 
 void* dlopen_vulkan_loader()
