index 644032c..542032e 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -3,6 +3,10 @@ cmake_minimum_required(VERSION 3.21.1)
 option(ENABLE_VCPKG "Enable the vcpkg package manager" ON)
 option(MACOS_BUNDLE "The executable when built on macOS will be created as an application bundle" OFF)
 option(ALLOW_PORTABLE "Allow Cemu to be run in portable mode" ON)
+# The native PlayStation 5 port (ps5cemu): FreeBSD-derived userland, Vulkan on the console's
+# RADV driver, a DualSense input provider and AudioOut. Its host code lives in CEMU_PS5_PORT_DIR.
+option(CEMU_PS5 "Build the native PlayStation 5 port" OFF)
+set(CEMU_PS5_PORT_DIR "" CACHE PATH "Directory of the PS5 port's host code (ps5cemu/port)")
 
 # used by CI script to set version:
